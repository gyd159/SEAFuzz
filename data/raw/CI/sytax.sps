PRESERVE.

SET RNG=MT MTINDEX=1.

OMS
 /SELECT TABLES
 /IF COMMANDS=['Descriptives']
     SUBTYPES=['Descriptive Statistics']
 /DESTINATION FORMAT=SAV
     OUTFILE='D:\outputx\outputx\libpng\xinjia\bootstrap_ci_raw2.sav'
     VIEWER=NO
 /TAG='CI'.

BOOTSTRAP
 /SAMPLING METHOD=SIMPLE
 /VARIABLES TARGET=VAR00001 TO VAR00052
 /CRITERIA CILEVEL=95 CITYPE=BCA NSAMPLES=10000.

DESCRIPTIVES VARIABLES=VAR00001 TO VAR00052
 /STATISTICS=MEAN STDDEV.

OMSEND TAG='CI'.

RESTORE.